{
  "name": "life-copilot-frontend",
  "version": "0.1.0",
  "description": "Typed Next.js client for the Life Copilot FastAPI service.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "generate:api": "python ../scripts/export_openapi.py --output openapi.json && openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
